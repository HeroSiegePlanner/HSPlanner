{
  "name": "hsplanner",
  "productName": "HSPlanner",
  "identifier": "com.zium.hsplanner.gpui",
  "description": "Native build planner for Hero Siege",
  "authors": [
    "zium1337"
  ],
  "publisher": "zium1337",
  "homepage": "https://github.com/zium1337/HSPlanner",
  "category": "Utility",
  "binaries": [
    {
      "path": "hsplanner",
      "main": true
    }
  ],
  "icons": [
    "icons/icon.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ],
  "macos": {
    "minimumSystemVersion": "15.0"
  },
  "nsis": {
    "installMode": "currentUser"
  },
  "deb": {
    "depends": [
      "libwayland-client0",
      "libxkbcommon0",
      "libvulkan1",
      "libfontconfig1",
      "libasound2t64",
      "libudev1",
      "libdbus-1-3"
    ]
  },
  "pacman": {
    "depends": [
      "wayland",
      "libxkbcommon",
      "vulkan-icd-loader",
      "fontconfig",
      "alsa-lib",
      "systemd-libs",
      "dbus"
    ]
  },
  "resources": [
    {
      "src": "../LICENSE",
      "target": "licenses/HSPlanner.txt"
    },
    {
      "src": "../crates/ui/assets/fonts/OFL.txt",
      "target": "licenses/Inter.txt"
    },
    {
      "src": "../crates/ui/assets/fonts/OFL-JetBrainsMono.txt",
      "target": "licenses/JetBrainsMono.txt"
    }
  ]
}
